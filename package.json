{
  "name": "web-sibberia",
  "private": true,
  "description": "Web de Sibberia. Sitio estático; solo las escenas 3D (assets/js/src) necesitan compilarse.",
  "scripts": {
    "build": "npm run build:hero && npm run build:accent",
    "build:hero": "esbuild assets/js/src/hero3d.js --bundle --minify --format=iife --target=es2018 --legal-comments=eof --global-name=SibHero3D --outfile=assets/js/hero3d.js",
    "build:accent": "esbuild assets/js/src/accent3d.js --bundle --minify --format=iife --target=es2018 --legal-comments=eof --global-name=SibAccent3D --outfile=assets/js/accent3d.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "three": "0.186.1"
  }
}
